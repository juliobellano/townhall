# Copy to .env.local and fill in. .env.local is gitignored; this file is safe to commit.

# Creator agent (default): Anthropic API. Enables the live creator agent.
ANTHROPIC_API_KEY=
# Model and effort for the creator agent (defaults: claude-sonnet-5-5, medium)
TOWNHALL_CREATOR_MODEL=claude-sonnet-5-5
TOWNHALL_CREATOR_EFFORT=medium

# Optional alternative: GMI Cloud Router (console.gmicloud.ai > Settings > API Keys).
# When set, it is tried before the Anthropic API.
# GMI_API_KEY=
# GMI_ROUTER_MODE=quality   # cost | balanced | quality

# Optional: time budget for live creator backends, in ms (default 90000)
# TOWNHALL_CREATOR_TIMEOUT_MS=90000

# Optional: force one creator backend: api | gmi | cli | cached (default auto)
# TOWNHALL_CREATOR=auto
